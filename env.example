# ─────────────────────────────────────────────────────────────────────────────
# .env — Variáveis de ambiente do JornadaVip
#
# Copie este arquivo para .env.local e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
# ID único da clínica. Usado para isolar dados no backend (RLS) e no localStorage.
# Cada implantação deve ter um ID diferente.
VITE_CLINIC_ID=default
VITE_CLINIC_NAME=Vip Estétic

# ── Backend / CRM ────────────────────────────────────────────────────────────
# Quando definido, o app usa o backend via API REST ao invés de localStorage.
# Deixe vazio para modo dev/offline.
# VITE_API_BASE_URL=https://api.suaclinica.com

# ── OAuth (Login social) ──────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials → Create OAuth Client ID (Web)
# Apple:  https://developer.apple.com/account/resources/identifiers
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
# VITE_APPLE_REDIRECT_URI=https://jornada.vipestetic.com.br/auth/apple/callback

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Em modo dev (sem VITE_API_BASE_URL), a key é usada diretamente pelo frontend.
# Em produção, as chamadas vão via proxy do backend — a key fica apenas no servidor.
VITE_GEMINI_API_KEY=

# ── Clínica ───────────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=5585000000000
VITE_INSTAGRAM_URL=https://instagram.com/vipestetic
VITE_YOUTUBE_URL=https://youtube.com/@vipestetic

# ── Analytics ─────────────────────────────────────────────────────────────────
VITE_GA_MEASUREMENT_ID=
VITE_SMARTLOOK_KEY=
